# App
NODE_ENV="development"
PORT="3000"
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3000"
LOG_LEVEL="info"

# Database
DATABASE_URL="postgresql://marketplace:marketplace_secret@localhost:5432/marketplace"

# Redis
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILISEARCH_URL="http://localhost:7700"
MEILISEARCH_KEY="marketplace_search_key"

# JWT
JWT_SECRET="replace-with-a-long-random-access-secret"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"
ENCRYPTION_KEY="replace-with-a-long-random-32-byte-encryption-secret"
CSRF_ENABLED="true"

# OTP / notifications
OTP_PROVIDER="mock"
SMTP_HOST=""
SMTP_FROM="no-reply@marketplace.local"
SMS_PROVIDER_URL=""
SMS_PROVIDER_KEY=""
SENDGRID_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Payments
PAYMENT_WEBHOOK_SECRET="replace-with-provider-webhook-secret"

# Storage / media
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
R2_ENDPOINT=""

# AI / embeddings
OPENAI_API_KEY=""
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="text-embedding-3-small"

# Observability
SENTRY_DSN=""

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# Default admin seed
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
