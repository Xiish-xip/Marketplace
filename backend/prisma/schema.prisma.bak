  updatedAt        DateTime       @updatedAt
  translationKey   TranslationKey @relation(fields: [translationKeyId], references: [id], onDelete: Cascade)

  @@unique([translationKeyId, language])
  @@index([language])
  @@map("translation_values")
}

model ProviderAdapter {
  id          String            @id @default(uuid())
  name        String
  provider    String
  baseUrl     String?
  methods     String            @default("[]")
  configSchema String?
  isEnabled   Boolean           @default(true)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  connections ProviderConnection[]

  @@index([provider, isEnabled])
  @@map("provider_adapters")
}

model ProviderConnection {
  id               String         @id @default(uuid())
  adapterId        String
  name             String
  credentials      String?
  config           String?
  isActive         Boolean        @default(true)
  isVerified       Boolean        @default(false)
  lastSyncAt       DateTime?
  lastError        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  adapter          ProviderAdapter @relation(fields: [adapterId], references: [id], onDelete: Cascade)
  importJobs DropshipImportJob[]

  @@index([adapterId, isActive])
  @@map("provider_connections")
}

model DropshipSupplier {
  id          String    @id @default(uuid())
  name        String
  provider    String
  storeUrl    String?
  apiEndpoint String?
  apiKey      String?
  apiSecret   String?
  currency    String    @default("USD")
  isVerified  Boolean   @default(false)
  isActive    Boolean   @default(true)
  metadata    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  mappings    DropshipProductMapping[]
  orders      DropshipOrder[]
  jobs        DropshipImportJob[]

  @@index([provider, isActive])
  @@map("dropship_suppliers")
}

model DropshipProductMapping {
  id               String          @id @default(uuid())
  supplierId       String
  localProductId   String?
  supplierSku      String          @unique
  supplierProductId String?
  supplierTitle    String
  supplierPrice    Float           @default(0)
  supplierCurrency String           @default("USD")
  costPrice        Float           @default(0)
  sellingPrice     Float           @default(0)
  quantity         Int             @default(0)
  supplierUrl      String?
  imageUrl         String?
  category         String?
  specifications   String?
  autoSync         Boolean         @default(true)
  lastSyncedAt     DateTime?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  supplier         DropshipSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, isActive])
  @@map("dropship_product_mappings")
}

model DropshipOrder {
  id              String          @id @default(uuid())
  supplierId      String
  localOrderId    String?
  supplierOrderId String
  items           String
  subtotal        Float           @default(0)
  shippingCost    Float           @default(0)
  totalCost       Float           @default(0)
  currency        String          @default("USD")
  status          String          @default("PENDING")
  estimatedDays   Int?
  trackingUrl     String?
  errorLog        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  supplier        DropshipSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, status])
  @@map("dropship_orders")
}

model DropshipImportJob {
  id             String          @id @default(uuid())
  supplierId     String?
  connectionId   String?
  status         String          @default("PENDING")
  totalItems     Int             @default(0)
  imported       Int             @default(0)
  failed         Int             @default(0)
  errors         String?
  mappingTemplate String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  supplier       DropshipSupplier? @relation(fields: [supplierId], references: [id])
  connection     ProviderConnection? @relation(fields: [connectionId], references: [id])

  @@index([supplierId, status])
  @@map("dropship_import_jobs")
}

model WebhookEndpoint {
  id          String   @id @default(uuid())
  url         String
  events      String
  headers     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("webhook_endpoints")
}

model ShippingProfile {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("shipping_profiles")
}
